---
import Layout from "../../layouts/Layout.astro";
import { ObjectId } from "mongodb";
import { getDb } from "../../lib/mongodb.js";

export const prerender = false;

const userId = Astro.cookies.get("userId")?.value;
const role = Astro.cookies.get("role")?.value;

if (!userId) {
	return Astro.redirect("/login?error=login-required");
}

if (role !== "loan_officer") {
	return Astro.redirect("/login?error=unauthorized");
}

const db = await getDb();
const applicationsCollection = db.collection("applications");

// Handle application deletion
if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();

	const action = formData.get("action")?.toString();
	const applicationId = formData.get("applicationId")?.toString();

	if (
		action === "delete" &&
		applicationId &&
		ObjectId.isValid(applicationId)
	) {
		await applicationsCollection.deleteOne({
			_id: new ObjectId(applicationId),
			userId: new ObjectId(userId)
		});

		return Astro.redirect("/dashboard/lo", 303);
	}
}

// Load applications belonging to this LO
const applications = await applicationsCollection
	.find({
		userId: new ObjectId(userId)
	})
	.sort({
		createdAt: -1
	})
	.toArray();

// Dashboard stats
const totalApplications = applications.length;

const inReviewCount = applications.filter(
	(application) => application.status === "in_review"
).length;

const approvedCount = applications.filter(
	(application) => application.status === "approved"
).length;

const pendingCount = applications.filter(
	(application) => application.status === "pending"
).length;
---

<Layout title="Loan Officer Dashboard">
	<section class="dashboard">

		<div class="dashboard-header">
			<div>
				<p class="eyebrow">Loan Portfolio</p>

				<h1>Loan Officer Dashboard</h1>

				<p>
					Manage applications, track decisions, and submit new loans.
				</p>
			</div>

			<a class="new-application" href="/applications/create">
				+ Create Application
			</a>
		</div>

		<!-- Dashboard Stats -->
		<section class="stats">
			<div class="stat-card">
				<span>Total Applications</span>
				<strong>{totalApplications}</strong>
			</div>

			<div class="stat-card pending">
				<span>Pending</span>
				<strong>{pendingCount}</strong>
			</div>

			<div class="stat-card review">
				<span>In Review</span>
				<strong>{inReviewCount}</strong>
			</div>

			<div class="stat-card approved">
				<span>Approved</span>
				<strong>{approvedCount}</strong>
			</div>
		</section>

		<section class="applications-section">
			<div class="section-header">
				<div>
					<h2>My Applications</h2>
					<p>Select an application to view underwriting details.</p>
				</div>
			</div>

			{applications.length === 0 ? (
				<div class="empty-state">
					<h3>No applications yet</h3>

					<p>
						Create your first loan application to get started.
					</p>

					<a href="/applications/create">
						Create Application
					</a>
				</div>
			) : (
				<div class="application-list">

					<div class="application-header">
						<span>Borrower</span>
						<span>Loan Request</span>
						<span>Purpose</span>
						<span>Status</span>
						<span></span>
					</div>

					{applications.map((application) => (

						<div
							class={`application-row status-${application.status}`}
						>

							<a
								class="application-details"
								href={`/underwriting/${application._id.toString()}`}
							>
								<p>
									<strong>
										{application.firstName} {application.lastName}
									</strong>
								</p>

								<p>
									${application.loanRequest.toLocaleString()}
								</p>

								<p>
									{application.purpose.replace("_", " ")}
								</p>

								<p class="status-text">
									{application.status.replace("_", " ")}
								</p>
							</a>

							<form
								method="POST"
								class="delete-form"
								onsubmit="return confirm('Delete this application? This cannot be undone.')"
							>
								<input
									type="hidden"
									name="action"
									value="delete"
								/>

								<input
									type="hidden"
									name="applicationId"
									value={application._id.toString()}
								/>

								<button
									type="submit"
									class="delete-button"
									aria-label="Delete application"
									title="Delete Application"
								>
									🗑
								</button>
							</form>

						</div>

					))}
				</div>
			)}
		</section>

	</section>
</Layout>

<style>
	.dashboard {
		max-width: 1050px;
		margin: 0 auto;
	}

	.dashboard-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.dashboard-header h1 {
		margin-bottom: 0.5rem;
	}

	.eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #2563eb;
	}

	.new-application {
		display: inline-block;
		padding: 0.8rem 1.1rem;
		background: #2563eb;
		color: white;
		text-decoration: none;
		border-radius: 9px;
		font-weight: 600;
		white-space: nowrap;
	}

	.new-application:hover {
		background: #1d4ed8;
	}

	/* Stats */

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.stat-card {
		background: white;
		border-radius: 12px;
		padding: 1.25rem;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
		border-left: 4px solid #9ca3af;
	}

	.stat-card span {
		display: block;
		font-size: 0.85rem;
		color: #6b7280;
		margin-bottom: 0.4rem;
	}

	.stat-card strong {
		font-size: 1.8rem;
		color: #111827;
	}

	.stat-card.pending {
		border-left-color: #9ca3af;
	}

	.stat-card.review {
		border-left-color: #38bdf8;
	}

	.stat-card.approved {
		border-left-color: #22c55e;
	}

	/* Applications */

	.applications-section {
		margin-top: 1rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		margin-bottom: 1rem;
	}

	.section-header h2 {
		margin-bottom: 0.25rem;
	}

	.section-header p {
		margin: 0;
		font-size: 0.9rem;
	}

	.application-list {
		display: grid;
		gap: 0.85rem;
	}

	.application-header {
		display: grid;
		grid-template-columns: 2fr 1.5fr 1.5fr 1fr 50px;
		gap: 1rem;
		padding: 0 1.25rem 0.4rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: #6b7280;
	}

	.application-row {
		display: grid;
		grid-template-columns: 1fr 50px;
		align-items: center;

		border-radius: 10px;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.application-row:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
	}

	.application-details {
		display: grid;
		grid-template-columns: 2fr 1.5fr 1.5fr 1fr;
		align-items: center;
		gap: 1rem;

		padding: 1rem 1.25rem;

		text-decoration: none;
		color: inherit;
	}

	.application-details p {
		margin: 0;
	}

	.status-text {
		font-weight: 600;
		text-transform: capitalize;
	}

	/* Status Colors */

	.status-pending {
		background: #f3f4f6;
	}

	.status-in_review {
		background: #e0f2fe;
	}

	.status-approved {
		background: #dcfce7;
	}

	.status-countered {
		background: #fef9c3;
	}

	.status-denied {
		background: #fee2e2;
	}

	/* Delete */

	.delete-form {
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
	}

	.delete-button {
		background: transparent;
		color: #6b7280;
		border: none;
		padding: 0.6rem;
		border-radius: 7px;
		cursor: pointer;
		font-size: 1rem;
	}

	.delete-button:hover {
		background: rgba(255, 255, 255, 0.55);
		color: #dc2626;
	}

	/* Empty */

	.empty-state {
		background: white;
		padding: 3rem;
		border-radius: 12px;
		text-align: center;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
	}

	.empty-state a {
		display: inline-block;
		margin-top: 0.75rem;
		font-weight: 600;
	}

	/* Responsive */

	@media (max-width: 800px) {
		.stats {
			grid-template-columns: repeat(2, 1fr);
		}

		.application-header {
			display: none;
		}

		.application-details {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
	}

	@media (max-width: 600px) {
		.dashboard-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.new-application {
			width: 100%;
			text-align: center;
		}

		.stats {
			grid-template-columns: 1fr;
		}
	}
</style>